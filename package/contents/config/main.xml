<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0 http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
  <kcfgfile name=""/>
  <group name="General">
    <!-- Calendar event plugins (Plasma's): holidaysevents, astronomicalevents (moon phases, seasons), alternatecalendar -->
    <entry name="enabledCalendarPlugins" type="StringList">
      <default>holidaysevents</default>
    </entry>
    <!-- -1 = KDE region default, 0 = Sunday, 1 = Monday, ... -->
    <entry name="firstDayOfWeek" type="Int">
      <default>0</default>
    </entry>
    <entry name="showWeekNumbers" type="Bool">
      <default>true</default>
    </entry>
    <!-- Week numbers: strength in % (fades toward the wallpaper; 100 = as strong as the accent colour),
         own colour ("" = the accent colour), smaller size (80 %, on the dates' baseline) and italic,
         so they aren't mistaken for dates (weeks 1-31) -->
    <!-- Month name in the header: false = short ("Oct 2026"), true = full ("October 2026"); locale names (CLDR) -->
    <entry name="fullMonthName" type="Bool">
      <default>false</default>
    </entry>
    <entry name="weekNumberStrength" type="Int">
      <default>70</default>
    </entry>
    <entry name="weekNumberColor" type="String">
      <default></default>
    </entry>
    <entry name="weekNumberSmaller" type="Bool">
      <default>true</default>
    </entry>
    <entry name="weekNumberItalic" type="Bool">
      <default>false</default>
    </entry>
    <!-- Colour for week numbers, other-month days and today's underline (Rainmeter style: 128,192,255) -->
    <entry name="accentColor" type="String">
      <default>#80c0ff</default>
    </entry>
    <!-- Shade the weekday labels with a faint box (LuaCalendar style); off: labels in the full text colour -->
    <entry name="weekdayChips" type="Bool">
      <default>false</default>
    </entry>
    <!-- Darken (light wallpaper) or keep (dark wallpaper) the accent and event colours so they stay readable -->
    <entry name="adaptColors" type="Bool">
      <default>true</default>
    </entry>
    <!-- Colour for days with events: its own hue so they stand out on light and dark wallpapers
         (LuaCalendar dimmed them to grey, which disappears on light wallpapers) -->
    <entry name="eventColor" type="String">
      <default>#ff8c1a</default>
    </entry>
  </group>
  <group name="Text">
    <!-- "" = the system font -->
    <entry name="fontFamily" type="String">
      <default></default>
    </entry>
    <!-- Size of the day numbers; everything else (labels, cells, gaps) scales with it -->
    <entry name="fontPointSize" type="Int">
      <default>14</default>
    </entry>
    <!-- 0 = theme colour, 1 = custom colour, 2 = automatic contrast against the wallpaper -->
    <entry name="textColorMode" type="Int">
      <default>2</default>
    </entry>
    <entry name="customPrimaryColor" type="String">
      <default>#ffffff</default>
    </entry>
    <!-- 0 = white or near-black, 1 = tinted from the wallpaper's colours -->
    <entry name="autoContrastStyle" type="Int">
      <default>0</default>
    </entry>
    <!-- Last computed automatic colour, used at start-up before the wallpaper is analysed -->
    <entry name="autoContrastColor" type="String">
      <default></default>
    </entry>
    <!-- Last measured wallpaper average colour (for adapting accent colours) -->
    <entry name="wallpaperAverageColor" type="String">
      <default></default>
    </entry>
  </group>
</kcfg>
